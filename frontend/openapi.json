                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Case-insensitive substring of name or CIK.",
              "title": "Q"
            },
            "description": "Case-insensitive substring of name or CIK."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(all|active|inactive|bankrupt|delisted|acquired)$",
