        }
      }
    },
    "/ranking": {
      "get": {
        "tags": [
          "ranking"
        ],
        "summary": "Ranking",
        "description": "Active companies we KNOW haven't inflected (stage_max <= 2), ranked by\nrevenue momentum, plus any company with a hand-verified catalyst estimate\nregardless of stage range.\n\nOrdering: fresh rows first \u2014 estimate-backed by nearest p50, then momentum\nby streak \u2014 with stale rows below all of them, most recently observed\nfirst. \"Stale\" means the latest observed quarter ended more than ~18\nmonths before `as_of`; such a company is still listed and filing, so the\nrow is demoted and labelled rather than dropped.\n\n`catalyst` is null when no estimate is on file. That is a real answer \u2014\nthe absence of an estimate is never filled in with a guess.",
        "operationId": "ranking_ranking_get",
        "parameters": [
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Simulated present. Omit for today.",
              "title": "As Of"
            },
            "description": "Simulated present. Omit for today."
          },
          {
            "name": "include_stale",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Stale rows are demoted, never dropped.",
              "default": true,
              "title": "Include Stale"
            },
            "description": "Stale rows are demoted, never dropped."
          },
          {
            "name": "estimates_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only rows with a real catalyst estimate on file.",
              "default": false,
              "title": "Estimates Only"
            },
            "description": "Only rows with a real catalyst estimate on file."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transitions": {
      "get": {
        "tags": [
          "ranking"
        ],
        "summary": "Transitions",
        "description": "Detected stage crossings across the whole universe, most recent first.\n\nThe default 2 -> 3 (first revenue -> inflection) is the signal this\nproject exists to find. Non-survivors are included: excluding them is\nprecisely the survivorship bias invariant 2 forbids.",
        "operationId": "transitions_transitions_get",
        "parameters": [
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          },
          {
            "name": "from_stage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 0,
              "default": 2,
              "title": "From Stage"
            }
          },
          {
            "name": "to_stage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 0,
              "default": 3,
              "title": "To Stage"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only transitions at or after this period end.",
              "title": "Since"
            },
            "description": "Only transitions at or after this period end."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Transition"
                  },
                  "title": "Response Transitions Transitions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/companies": {
      "get": {
