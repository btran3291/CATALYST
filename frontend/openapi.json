{
  "openapi": "3.1.0",
  "info": {
    "title": "Catalyst",
    "summary": "Point-in-time research API for pre-revenue and early-revenue public companies.",
    "description": "HTTP layer over the Catalyst pipeline.\n\nRead-only by construction: every query this module runs itself goes through\na `mode=ro` sqlite connection, and the pipeline functions it calls are all\ninvoked with persist=False. Nothing reachable over HTTP can write to the\npoint-in-time store.\n\nPoint-in-time (invariant 1) is preserved through the HTTP surface: every\nendpoint that reads derived values takes `as_of`, which is threaded down\ninto `knowledge_date <= as_of` filters in quarters/stages and\n`effective_date <= as_of` in the status-event join. An unset `as_of` means\n\"today\", resolved once at the request boundary so the value that reaches\nthe cache key and the value that reaches the classifier are the same date.\n\nRun it:\n    uvicorn api:app --reload\nInteractive docs at /docs; the OpenAPI schema at /openapi.json is what the\nfront end (planning step 5) will be generated against.\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/universe/stats": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Universe Stats",
        "description": "Universe composition as of a date. Non-survivors are counted, never\nexcluded \u2014 they stay in the universe permanently (invariant 2).",
        "operationId": "universe_stats_universe_stats_get",
        "parameters": [
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
